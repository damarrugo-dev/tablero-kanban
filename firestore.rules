rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo personas que iniciaron sesión con un correo de la empresa (enlace al correo o Microsoft).
    function esDeLaEmpresa() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@(hitss|anava)[.]com$')
        // correo confirmado (enlace al correo) o cuenta de Microsoft
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'microsoft.com');
    }
    function esAdministrador() {
      return esDeLaEmpresa()
        && request.auth.token.email.lower() in ['marrugod@hitss.com'];
    }
    // Registro de un acceso: solo esos campos, con la hora del servidor
    function registroValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'email', 'nombre', 'tablero', 'navegador', 'fecha'])
        && d.fecha == request.time
        && d.email is string && d.email.size() <= 200
        && d.tablero is string && d.tablero.size() <= 60
        && d.navegador is string && d.navegador.size() <= 60
        && (!('nombre' in d) || (d.nombre is string && d.nombre.size() <= 100));
    }

    match /tableros/{tablero} {
      allow read, write: if esDeLaEmpresa();
      match /tarjetas/{tarjeta} {
        allow read, write: if esDeLaEmpresa();
      }
    }

    match /accesos/{id} {
      // Pedir el enlace o ser rechazado ocurre antes de iniciar sesión
      allow create: if registroValido() && (
        (request.resource.data.tipo in ['solicitud', 'rechazado'] && !('nombre' in request.resource.data))
        || (request.resource.data.tipo == 'ingreso' && esDeLaEmpresa()
            && request.resource.data.email == request.auth.token.email.lower())
      );
      // Nadie puede cambiar ni borrar el registro; solo el administrador lo lee
      allow read: if esAdministrador();
      allow update, delete: if false;
    }
  }
}
